# Haley local configuration example
# Copy values into .env.local and fill secrets only on your machine.

# Runtime mode:
# BACKTEST = historical data test
# PAPER = real Upbit market data + virtual KRW balance
# DRY_RUN = run until just before real order submission
# LIVE = real orders, disabled until explicit later approval
HALEY_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Upbit API
# PAPER with public market data can run without keys.
# For private balance/order checks, use keys with minimum permissions only:
# asset lookup, order lookup, order create. Never enable withdrawal permission.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_API_BASE_URL=https://api.upbit.com
UPBIT_WS_URL=wss://api.upbit.com/websocket/v1

# Market selection
QUOTE_CURRENCY=KRW
MARKET_SELECTION=TOP_KRW_ALT_BY_24H_VALUE
TOP_ALT_COUNT=10
INCLUDE_MAJOR_MARKETS=false
EXCLUDED_MARKETS=

# Paper trading
# PAPER executes virtual trades against the strategy state.
# It must update virtual cash, positions, fills, PnL, stops, and exits.
PAPER_INITIAL_CASH_KRW=1000000
PAPER_VIRTUAL_TRADING_ENABLED=true
PAPER_RESET_ON_START=false
PAPER_ORDER_FILL_MODEL=ORDERBOOK
PAPER_ALLOW_REAL_ORDER_API=false

# Risk controls
RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=3
MAX_SYMBOL_EXPOSURE_PCT=0.25
MAX_TOTAL_CRYPTO_EXPOSURE_PCT=0.60
MAX_CORRELATED_EXPOSURE_PCT=0.35
MAX_UNPROTECTED_POSITION_SEC=10

# Strategy defaults
TIMEFRAME_ENTRY=5m
TIMEFRAME_FILTER=15m
ATR_PERIOD=14
PIVOT_LEFT=2
PIVOT_RIGHT=2
MIN_GAP_PCT=0.0015
MIN_GAP_ATR=0.25
IMPULSE_ATR_MULT=1.2
VOLUME_MULT=1.3
BREAK_THRESHOLD=0.0008
RECLAIM_WINDOW=3
WICK_RATIO_MIN=0.45

# Execution and data quality
MAX_SPREAD_PCT=0.002
CANDLE_GRACE_MS=1500
STALE_TIMEOUT_MS=5000
MIN_STOP_PCT=0.002
MAX_STOP_PCT=0.02
ENTRY_TIMEOUT_SEC=20

# External risk filters
# Keep UPBIT_ONLY first. EXTERNAL_OPTIONAL / EXTERNAL_REQUIRED can be added later.
EXTERNAL_RISK_MODE=UPBIT_ONLY

# Local persistence
DATABASE_URL=sqlite:///./data/haley.local.sqlite3
AUDIT_LOG_RETENTION_DAYS=365

# Operator-controlled safety
REQUIRE_OPERATOR_CONFIRMATION=true
DEFAULT_OPERATOR_ID=local-user
KILL_SWITCH_ON_START=false

# Notifications
# Channel setup is intentionally deferred.
ALERTS_ENABLED=false
ALERT_CHANNEL=disabled

# Local UI/API
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=3000
